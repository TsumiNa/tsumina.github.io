---
/**
 * Google Analytics 4 slot. Renders nothing until site.gaId is configured
 * (PUBLIC_GA_ID build variable), so the default build ships no tracking.
 */
import { site } from '../config/site';
const id = site.gaId;
---

{
  id && (
    <>
      <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${id}`} />
      <script is:inline define:vars={{ id }}>
        window.dataLayer = window.dataLayer || []; function gtag() {dataLayer.push(arguments)}
        gtag('js', new Date()); gtag('config', id);
      </script>
    </>
  )
}
