---
import { type Locale, localePath, ui } from '../i18n';
const { lang = 'en' } = Astro.props as { lang?: Locale };
const t = ui[lang];
const nav: [string, string][] = [
  ['research', t.research],
  ['publications', t.publications],
  ['blog', t.blog],
  ['notes', t.notes],
  ['cv', t.cv],
];
const bare = Astro.url.pathname.replace(/^\/(ja|zh)(?=\/|$)/, '') || '/';
const active = bare.split('/')[1] ?? '';
---

<header class="site-header no-print">
  <nav class="container nav" aria-label="Primary">
    <a class="brand" href={localePath(lang)}>{t.displayName}</a>
    <div class="nav-links">
      {
        nav.map(([path, label]) => (
          <a href={localePath(lang, path)} aria-current={active === path ? 'page' : undefined}>
            {label}
          </a>
        ))
      }
    </div>
    <div class="nav-tools">
      <a class="icon-button" href="/search" aria-label={t.search}>
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" aria-hidden="true">
          <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2"></circle>
          <path d="M16.5 16.5 21 21" stroke="currentColor" stroke-width="2" stroke-linecap="round"
          ></path>
        </svg>
      </a>
      <label class="lang-select">
        <span class="sr-only">{t.language}</span>
        <select id="language" aria-label={t.language}>
          <option value="en" selected={lang === 'en'}>EN</option>
          <option value="ja" selected={lang === 'ja'}>JA</option>
          <option value="zh" selected={lang === 'zh'}>ZH</option>
        </select>
      </label>
      <button id="theme-toggle" class="icon-button" type="button" aria-label={t.theme}>
        <svg class="icon-sun" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
          <circle cx="12" cy="12" r="4.5" fill="currentColor"></circle>
          <path
            d="M12 2.5v3M12 18.5v3M2.5 12h3M18.5 12h3M5 5l2 2M17 17l2 2M19 5l-2 2M7 17l-2 2"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"></path>
        </svg>
        <svg class="icon-moon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
          <path d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5a8.5 8.5 0 1 0 11 11Z" fill="currentColor"
          ></path>
        </svg>
      </button>
      <details class="mobile-nav">
        <summary aria-label={t.menu}>
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <path
              d="M4 6.5h16M4 12h16M4 17.5h16"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"></path>
          </svg>
        </summary>
        <div class="mobile-nav-panel">
          <a href={localePath(lang)} aria-current={active === '' ? 'page' : undefined}>{t.home}</a>
          {
            nav.map(([path, label]) => (
              <a href={localePath(lang, path)} aria-current={active === path ? 'page' : undefined}>
                {label}
              </a>
            ))
          }
        </div>
      </details>
    </div>
  </nav>
</header>
<script is:inline>
  const root = document.documentElement;
  document.querySelector('#theme-toggle')?.addEventListener('click', () => {
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {}
  });
  document.querySelector('#language')?.addEventListener('change', (event) => {
    const lang = event.target.value;
    try {
      localStorage.setItem('language', lang);
    } catch {}
    // Prefer the page's own translation, advertised via its hreflang links;
    // fall back to the section index in the target language.
    const hreflang = lang === 'zh' ? 'zh-Hans' : lang;
    const alternate = document.querySelector(`link[rel="alternate"][hreflang="${hreflang}"]`);
    if (alternate) {
      location.href = alternate.href;
      return;
    }
    const section = location.pathname.replace(/^\/(ja|zh)(?=\/|$)/, '').split('/')[1] ?? '';
    location.href = (lang === 'en' ? '' : `/${lang}`) + `/${section}`;
  });
</script>
