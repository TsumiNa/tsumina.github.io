---
import { getCollection } from 'astro:content';
import { researchThemes, site } from '../../config/site';
import { cv } from '../../data/cv';
import { type Locale, localePath, ui } from '../../i18n';
import { cvUI } from '../../i18n/cv';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublications } from '../../utils/publications';
import { personLd, websiteLd } from '../../utils/structured-data';

const { lang = 'en' } = Astro.props as { lang?: Locale };
const t = ui[lang];
const profile = cvUI[lang];

const pubs = getPublications();
const featured = pubs.filter((p) => p.featured);
const highlighted = (
  featured.length > 0 ? featured : pubs.filter((p) => p.type === 'journal-article')
).slice(0, 4);

const collect = async (name: 'blog' | 'notes') =>
  (await getCollection(name, ({ data }) => !data.draft && data.lang === lang)).map((entry) => ({
    kind: name,
    entry,
  }));
const writing = [...(await collect('blog')), ...(await collect('notes'))]
  .sort((a, b) => b.entry.data.published.valueOf() - a.entry.data.published.valueOf())
  .slice(0, 4);

const appointments = cv.appointments.map((a) => `${a.title}, ${a.organization}`).join(' · ');
const projects = cv.projects.slice(0, 6);
---

<BaseLayout title={site.title} {lang} jsonLd={[websiteLd(), personLd()]}>
  <div class="container page" data-pagefind-body>
    <section class="hero">
      <p class="eyebrow">{profile.intro}</p>
      <h1>{t.fullName}</h1>
      <p class="lead">{t.lead}</p>
      <p class="hero-affiliation">{appointments}</p>
      <div class="actions">
        <a class="button primary" href={localePath(lang, 'publications')}>{t.publications}</a>
        <a class="button" href={localePath(lang, 'cv')}>{t.cv}</a>
        <a class="button" href={localePath(lang, 'blog')}>{t.blog}</a>
      </div>
      <p class="hero-profiles">
        <a href={site.orcid}>ORCID</a>
        <a href={site.github}>GitHub</a>
        <a href={site.researchmap}>researchmap</a>
        <a href={`mailto:${site.email}`}>Email</a>
      </p>
    </section>

    <section class="home-section">
      <h2 class="section-title">{t.focus}</h2>
      <ol class="theme-list">
        {
          researchThemes.map((theme, index) => (
            <li>
              <span class="theme-index">{String(index + 1).padStart(2, '0')}</span>
              <h3>{theme.title}</h3>
              <p>{theme.description}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <div class="split">
      <section class="home-section">
        <h2 class="section-title">{t.selectedPublications}</h2>
        {
          highlighted.map((p) => (
            <article class="entry entry-compact">
              <h3>{p.doi ? <a href={`https://doi.org/${p.doi}`}>{p.title}</a> : p.title}</h3>
              <p class="meta">
                <em>{p.venue}</em>
                {p.year && ` · ${p.year}`}
              </p>
            </article>
          ))
        }
        {pubs.length === 0 && <p class="meta">{t.empty}</p>}
        {
          pubs.length > 0 && (
            <p class="more-link">
              <a href={localePath(lang, 'publications')}>{t.allPublications} →</a>
            </p>
          )
        }
      </section>
      <section class="home-section">
        <h2 class="section-title">{t.writing}</h2>
        {
          writing.map(({ kind, entry }) => (
            <article class="entry entry-compact">
              <h3>
                <a href={localePath(lang, `${kind}/${entry.id}`)}>{entry.data.title}</a>
              </h3>
              <p class="meta">
                <time datetime={entry.data.published.toISOString()}>
                  {entry.data.published.toLocaleDateString(lang)}
                </time>
                {' · '}
                {kind === 'blog' && 'category' in entry.data
                  ? t.categories[entry.data.category]
                  : t.notes}
              </p>
            </article>
          ))
        }
        {writing.length === 0 && <p class="meta">{t.empty}</p>}
      </section>
    </div>

    <section class="home-section">
      <h2 class="section-title">{t.software}</h2>
      <ul class="project-grid">
        {
          projects.map((project) => (
            <li class="project-card">
              <h3 class="project-name">
                {'url' in project && project.url ? (
                  <a href={project.url}>{project.name}</a>
                ) : (
                  project.name
                )}
              </h3>
              <p>{project.description}</p>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</BaseLayout>
