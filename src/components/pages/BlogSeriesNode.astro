---
import { localePath, type Locale } from '../../i18n';
import { blogSlug, type BlogSeriesNode } from '../../utils/blog-series';

const { node, lang } = Astro.props as { node: BlogSeriesNode; lang: Locale };
const position = node.position.join('.');
---

<li class="blog-series-node">
  <article class:list={['blog-series-entry', { 'has-banner': node.entry.data.banner }]}>
    <span class="blog-series-position" aria-hidden="true">{position}</span>
    <div>
      <h3>
        <a href={localePath(lang, `blog/${blogSlug(node.entry.id)}`)}>{node.entry.data.title}</a>
      </h3>
      {
        node.entry.data.description && (
          <p class="entry-description">{node.entry.data.description}</p>
        )
      }
    </div>
    {
      node.entry.data.banner && (
        <img
          class="blog-series-banner"
          src={node.entry.data.banner.src}
          alt={node.entry.data.banner.alt}
          loading="lazy"
        />
      )
    }
  </article>
  {
    node.children.length > 0 && (
      <ol class="blog-series-level">
        {node.children.map((child) => (
          <Astro.self node={child} {lang} />
        ))}
      </ol>
    )
  }
</li>
