---
import { site } from '../config/site';
import type { Locale } from '../i18n';

type Alternates = Partial<Record<Locale, string>>;
interface Props {
  title?: string;
  description?: string;
  lang?: Locale;
  /**
   * Root-relative paths of this page in each locale. When omitted, the page is
   * assumed to exist in all three locales at the same bare path (true for all
   * section pages). Articles pass only the translations that actually exist so
   * hreflang never advertises a 404.
   */
  alternates?: Alternates;
  article?: { published: Date; updated?: Date; tags?: string[] };
  jsonLd?: object[];
  image?: string;
  noindex?: boolean;
}
const {
  title = site.title,
  description = site.description,
  lang = 'en',
  alternates,
  article,
  jsonLd = [],
  image,
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, site.url);
const bare = Astro.url.pathname.replace(/^\/(ja|zh)(?=\/|$)/, '') || '/';
const resolved: Alternates = alternates ?? {
  en: bare,
  ja: bare === '/' ? '/ja/' : `/ja${bare}`,
  zh: bare === '/' ? '/zh/' : `/zh${bare}`,
};
const hreflangOf: Record<Locale, string> = { en: 'en', ja: 'ja', zh: 'zh-Hans' };
const alternateLinks = (Object.entries(resolved) as [Locale, string][]).map(([l, path]) => ({
  hreflang: hreflangOf[l],
  href: new URL(path, site.url),
}));
const xDefault = new URL(resolved.en ?? Astro.url.pathname, site.url);
const ogLocale = lang === 'zh' ? 'zh_CN' : lang === 'ja' ? 'ja_JP' : 'en_US';
const ogImage = image ? new URL(image, site.url) : undefined;
---

<title>{title}</title>
<meta name="description" content={description} />
<meta name="author" content={site.name} />
{noindex && <meta name="robots" content="noindex, nofollow" />}
<link rel="canonical" href={canonical} />
<meta property="og:type" content={article ? 'article' : 'website'} />
<meta property="og:site_name" content={site.title} />
<meta property="og:locale" content={ogLocale} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
{ogImage && <meta property="og:image" content={ogImage} />}
<meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
{ogImage && <meta name="twitter:image" content={ogImage} />}
{
  article && (
    <>
      <meta property="article:published_time" content={article.published.toISOString()} />
      {article.updated && (
        <meta property="article:modified_time" content={article.updated.toISOString()} />
      )}
      {article.tags?.map((tag) => (
        <meta property="article:tag" content={tag} />
      ))}
    </>
  )
}
{alternateLinks.map((l) => <link rel="alternate" hreflang={l.hreflang} href={l.href} />)}
<link rel="alternate" hreflang="x-default" href={xDefault} />
{
  jsonLd.map((entry) => (
    <script is:inline type="application/ld+json" set:html={JSON.stringify(entry)} />
  ))
}
