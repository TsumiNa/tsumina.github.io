---
import { getCollection, render } from 'astro:content';
import { localePath, type Locale } from '../../../i18n';
import ArticleLayout from '../../../layouts/ArticleLayout.astro';

export async function getStaticPaths() {
  const all = await getCollection('notes', ({ data }) => !data.draft);
  return all
    .filter((entry) => entry.data.lang !== 'en')
    .map((entry) => {
      const alternates = Object.fromEntries(
        all
          .filter(
            (other) =>
              other.id === entry.id ||
              (entry.data.translationKey &&
                other.data.translationKey === entry.data.translationKey),
          )
          .map((other) => [other.data.lang, localePath(other.data.lang, `notes/${other.id}`)]),
      ) as Partial<Record<Locale, string>>;
      return { params: { lang: entry.data.lang, slug: entry.id }, props: { entry, alternates } };
    });
}
const { entry, alternates } = Astro.props;
const { Content } = await render(entry);
---

<ArticleLayout kind="notes" {...entry.data} {alternates}><Content /></ArticleLayout>
