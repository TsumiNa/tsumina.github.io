---
import BlogIndexPage from '../../components/pages/BlogIndexPage.astro';
import CVPage from '../../components/pages/CVPage.astro';
import NotesIndexPage from '../../components/pages/NotesIndexPage.astro';
import PublicationsPage from '../../components/pages/PublicationsPage.astro';
import ResearchPage from '../../components/pages/ResearchPage.astro';
import type { Locale } from '../../i18n';

export function getStaticPaths() {
  return ['ja', 'zh'].flatMap((lang) =>
    ['research', 'publications', 'blog', 'notes', 'cv'].map((section) => ({
      params: { lang, section },
    })),
  );
}
const { lang, section } = Astro.params as { lang: Locale; section: string };
---

{section === 'research' && <ResearchPage {lang} />}
{section === 'publications' && <PublicationsPage {lang} />}
{section === 'blog' && <BlogIndexPage {lang} />}
{section === 'notes' && <NotesIndexPage {lang} />}
{section === 'cv' && <CVPage {lang} />}
