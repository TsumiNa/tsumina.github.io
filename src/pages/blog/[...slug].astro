---
import { getCollection, render } from 'astro:content';
import BlogDirectoryPage from '../../components/pages/BlogDirectoryPage.astro';
import { localePath, locales, type Locale } from '../../i18n';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import {
  blogDirectorySlug,
  getBlogDirectories,
  getBlogSeriesNavigation,
  isBlogEntryVisible,
  type BlogDirectory,
  type BlogEntry,
} from '../../utils/blog-series';

export async function getStaticPaths() {
  const all = await getCollection('blog');
  const english = all.filter((entry) => entry.data.lang === 'en');
  const directoryPaths = new Map<Locale, Set<string>>(
    locales.map((lang) => [
      lang,
      new Set(
        getBlogDirectories(all.filter((entry) => entry.data.lang === lang)).map(blogDirectorySlug),
      ),
    ]),
  );

  const articles = english.map((entry) => {
    const alternates = Object.fromEntries(
      all
        .filter(
          (other) =>
            other.id === entry.id ||
            (entry.data.translationKey && other.data.translationKey === entry.data.translationKey),
        )
        .map((other) => [other.data.lang, localePath(other.data.lang, `blog/${other.id}`)]),
    ) as Partial<Record<Locale, string>>;
    return { params: { slug: entry.id }, props: { entry, alternates } };
  });

  const directories = getBlogDirectories(english).map((directory) => {
    const slug = blogDirectorySlug(directory);
    const alternates = Object.fromEntries(
      locales
        .filter((lang) => directoryPaths.get(lang)?.has(slug))
        .map((lang) => [lang, localePath(lang, `blog/${slug}`)]),
    ) as Partial<Record<Locale, string>>;
    return { params: { slug }, props: { directory, alternates } };
  });

  return [...articles, ...directories];
}

type PageProps =
  | { entry: BlogEntry; directory?: undefined; alternates: Partial<Record<Locale, string>> }
  | { entry?: undefined; directory: BlogDirectory; alternates: Partial<Record<Locale, string>> };
const { entry, directory, alternates } = Astro.props as PageProps;
const rendered = entry ? await render(entry) : undefined;
const series = entry
  ? getBlogSeriesNavigation(
      await getCollection(
        'blog',
        ({ data }) => data.lang === entry.data.lang && data.category === entry.data.category,
      ),
      entry.id,
    )
  : undefined;
---

{
  entry ? (
    <ArticleLayout
      kind="blog"
      {...entry.data}
      show={isBlogEntryVisible(entry)}
      {alternates}
      {series}
      entryId={entry.id}
    >
      {rendered && <rendered.Content />}
    </ArticleLayout>
  ) : (
    directory && <BlogDirectoryPage {directory} lang="en" {alternates} />
  )
}
