---
import BaseLayout from './BaseLayout.astro';
import type { Locale } from '../i18n';
const {
  title,
  description,
  published,
  updated,
  tags = [],
  lang = 'en',
  status,
} = Astro.props as {
  title: string;
  description?: string;
  published: Date;
  updated?: Date;
  tags?: string[];
  lang?: Locale;
  status?: string;
};
---

<BaseLayout {title} {description} {lang}
  ><article class="container page" data-pagefind-body>
    <header class="article-head">
      <p class="eyebrow">{status ? `${status} note` : 'Article'}</p><h1>{title}</h1>{
        description && <p class="lead">{description}</p>
      }<p class="meta">
        <time datetime={published.toISOString()}>{published.toLocaleDateString(lang)}</time>{
          updated && (
            <>
              {' '}
              · Updated{' '}
              <time datetime={updated.toISOString()}>{updated.toLocaleDateString(lang)}</time>
            </>
          )
        }
        {tags.length > 0 && <> · {tags.join(' · ')}</>}
      </p>
    </header><div class="prose"><slot /></div>
  </article></BaseLayout
>
