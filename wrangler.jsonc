{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "know",
  "compatibility_date": "2026-09-28",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
  },
  // Required (even empty) by `wrangler preview`, which Workers Builds runs
  // for branch/PR preview deployments. Assets stay configured at top level.
  "previews": {},
}
